# docker-prod/.env  — kopiere diese Datei nach .env und trage echte Secrets ein.
# Die echte .env wird NICHT versioniert (siehe .gitignore).
# Secrets erzeugen:  openssl rand -hex 24

ESPOCRM_VERSION=latest

# --- Datenbank ---
MYSQL_ROOT_PASSWORD=__CHANGE_ME_root__
MYSQL_DATABASE=espocrm
MYSQL_USER=espocrm
MYSQL_PASSWORD=__CHANGE_ME_db__

# --- EspoCRM Admin (Erst-Login) ---
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=__CHANGE_ME_admin__

# --- Öffentliche URL (hinter dem Reverse-Proxy) ---
ESPOCRM_SITE_URL=https://crm.most-connect.com
