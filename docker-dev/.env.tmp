# docker-dev/.env  — kopiere diese Datei nach .env.
# Für lokal reichen einfache Passwörter (nicht öffentlich erreichbar).

ESPOCRM_VERSION=latest
HTTP_PORT=8080

# --- Datenbank ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=espocrm
MYSQL_USER=espocrm
MYSQL_PASSWORD=espocrm

# --- EspoCRM Admin (Erst-Login) ---
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=admin123

# --- Öffentliche URL (lokal) ---
ESPOCRM_SITE_URL=http://localhost:8080
